
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPanel() {
      let userRole = getUserRole();
      return userRole == 'panel';
    }

    function isHR() {
      let userRole = getUserRole();
      return userRole == 'hr';
    }

    function isAgency() {
      let userRole = getUserRole();
      return userRole == 'agency';
    }

    match /candidates/{candidateId} {
      allow read: if isUserAuthenticated();

      allow create: if isUserAuthenticated() && (isHR() || isAgency());

      // Allow update access only to the Panel role
      allow write: if isUserAuthenticated() && isPanel();

      // No user can delete a candidate record
      allow delete: if false;
    }

    // Closed by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
